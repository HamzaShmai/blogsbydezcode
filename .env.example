# App
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# REQUIRED — use long random values (32+ chars). Never commit real secrets.
# Generate: openssl rand -base64 48
NEXTAUTH_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

# Local job auth (optional). In production QStash signatures are mandatory.
INTERNAL_JOB_SECRET=
ALLOW_OFFLINE_AI=true
JOBS_INLINE=true

# Database — Neon / Postgres. Never expose this to the browser.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Upstash (required in production for cloud jobs)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Search Console OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gsc/callback

# AI / research (server-only — never NEXT_PUBLIC_*)
# Grok / xAI — preferred free-tier-friendly writer when you have a key
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=

DEMO_WEBHOOK_URL=http://127.0.0.1:3999/publish
